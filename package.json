{
  "name": "salah-kalender",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "NanPan",
  "description": "Salah-kalender",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-ocr-assets.mjs && vite build",
    "test": "node --test tests/*.test.js",
    "test:ocr": "node scripts/copy-ocr-assets.mjs && vite build && node tests/e2e/ocr-e2e.mjs",
    "sounds": "node scripts/make-sounds.mjs",
    "test:ocr-bench": "node scripts/copy-ocr-assets.mjs && vite build && node tests/e2e/ocr-bench.mjs --strict",
    "test:native": "node scripts/copy-ocr-assets.mjs && vite build && node tests/e2e/native-e2e.mjs",
    "test:pdf": "node scripts/copy-ocr-assets.mjs && vite build && node tests/e2e/pdf-e2e.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "se.salahkalender.app",
    "productName": "Salah-kalender",
    "copyright": "NanPan",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Salah-kalender-v${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Salah-kalender-v${version}-windows-portable.${ext}"
    }
  }
}
